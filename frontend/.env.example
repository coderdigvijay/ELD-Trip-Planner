# Inlined into the public bundle at build time. Never put the ORS key here.
# Backend origin, no trailing slash. Must match connect-src in vercel.json.
VITE_API_BASE_URL=http://localhost:8000

# Optional. Public CARTO tile key (domain restricted). When absent the map
# falls back to OSM raster tiles.
VITE_CARTO_API_KEY=
