# Copy to backend/.env for local development. Never commit .env. Documents every variable the
# backend reads (docs/DEPLOYMENT.md section 1).

# --- Mode ---------------------------------------------------------------------------------------
# Defaults to false. Set true ONLY for local development. Settings refuse to boot with true when
# Render's RENDER env var is present.
DJANGO_DEBUG=true

# --- Secrets (required when DJANGO_DEBUG is false) --------------------------------------------------
# Long random string. Render generates it (generateValue in render.yaml).
DJANGO_SECRET_KEY=
# OpenRouteService token. Server side only: never in the frontend, logs, URLs or error bodies.
ORS_API_KEY=

# --- Network ---------------------------------------------------------------------------------------
# Comma list. Required when DJANGO_DEBUG is false. Local default: localhost,127.0.0.1,[::1]
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma list of exact origins, no wildcard, no trailing slash. Localhost only in local .env.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Number of trusted proxies in front of the app (Render: expected 1, verify per DEPLOYMENT section 5).
# Required integer >= 1 when DJANGO_DEBUG is false; the app refuses to boot otherwise.
NUM_PROXIES=0

# --- Set by the platform, not by you --------------------------------------------------------------
# RENDER                    present on Render; forbids DJANGO_DEBUG=true
# RENDER_EXTERNAL_HOSTNAME  appended to ALLOWED_HOSTS when present
# PORT                      gunicorn bind port (default 8000)

# --- Optional ----------------------------------------------------------------------------------------
# Root log level. Default: DEBUG when DJANGO_DEBUG is true, else INFO.
# LOG_LEVEL=INFO
# Hypothesis profile for tests: dev (default), ci, deep.
# HYPOTHESIS_PROFILE=dev
