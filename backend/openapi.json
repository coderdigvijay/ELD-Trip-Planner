{
    "openapi": "3.0.3",
    "info": {
        "title": "ELD Trip Planner API",
        "version": "1.0.0",
        "description": "Plans a truck trip and its FMCSA daily log sheets."
    },
    "paths": {
        "/api/v1/health": {
            "get": {
                "operationId": "getHealth",
                "description": "Liveness and keep-warm. Never calls ORS, never throttled.",
                "summary": "Liveness check",
                "tags": [
                    "health"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Unexpected error"
                    }
                }
            }
        },
        "/api/v1/places/autocomplete": {
            "get": {
                "operationId": "autocompletePlaces",
                "description": "GET /api/v1/places/autocomplete?q=.",
                "summary": "US place suggestions",
                "parameters": [
                    {
                        "in": "query",
                        "name": "q",
                        "schema": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 100
                        },
                        "description": "3 to 100 characters after trimming. No control characters.",
                        "required": true
                    }
                ],
                "tags": [
                    "places"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AutocompleteResponse"
                                }
                            }
                        },
                        "description": "At most 5 suggestions. Cache-Control: public, max-age=3600."
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "VALIDATION_ERROR: q is missing, too short, too long or has control characters."
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "NOT_FOUND: there is no API endpoint at this address."
                    },
                    "405": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "METHOD_NOT_ALLOWED: this endpoint does not accept that HTTP method."
                    },
                    "429": {
                        "headers": {
                            "Retry-After": {
                                "schema": {
                                    "type": "integer"
                                },
                                "description": "Seconds to wait, 1 to 300. Same value as error.retry_after_s."
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Rate limited. Read retry_after_s or the Retry-After header."
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Unexpected error. Quote request_id."
                    },
                    "503": {
                        "headers": {
                            "Retry-After": {
                                "schema": {
                                    "type": "integer"
                                },
                                "description": "Seconds to wait, 1 to 300. Same value as error.retry_after_s."
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Routing service unavailable or out of quota (UPSTREAM_UNAVAILABLE, UPSTREAM_QUOTA_EXCEEDED)."
                    }
                }
            }
        },
        "/api/v1/trips/plan": {
            "post": {
                "operationId": "planTrip",
                "description": "POST /api/v1/trips/plan.",
                "summary": "Plan a trip with stops and daily log sheets",
                "tags": [
                    "trips"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PlanTripRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PlanTripResponse"
                                }
                            }
                        },
                        "description": "The plan. Cache-Control: no-store."
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "VALIDATION_ERROR: the request must change. See field and details."
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "LOCATION_NOT_FOUND, UNSUPPORTED_LOCATION, ROUTE_NOT_FOUND or TRIP_TOO_LONG: the trip cannot be planned as entered."
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "NOT_FOUND: there is no API endpoint at this address."
                    },
                    "405": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "METHOD_NOT_ALLOWED: this endpoint does not accept that HTTP method."
                    },
                    "429": {
                        "headers": {
                            "Retry-After": {
                                "schema": {
                                    "type": "integer"
                                },
                                "description": "Seconds to wait, 1 to 300. Same value as error.retry_after_s."
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Rate limited. Read retry_after_s or the Retry-After header."
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Unexpected error. Quote request_id."
                    },
                    "503": {
                        "headers": {
                            "Retry-After": {
                                "schema": {
                                    "type": "integer"
                                },
                                "description": "Seconds to wait, 1 to 300. Same value as error.retry_after_s."
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Routing service unavailable or out of quota (UPSTREAM_UNAVAILABLE, UPSTREAM_QUOTA_EXCEEDED)."
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ApiVersion": {
                "enum": [
                    "1"
                ],
                "type": "string",
                "description": "* `1` - 1"
            },
            "Assumption": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "text"
                ]
            },
            "AutocompleteResponse": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PlaceSuggestion"
                        }
                    }
                },
                "required": [
                    "items"
                ]
            },
            "Bounds": {
                "type": "object",
                "properties": {
                    "south": {
                        "type": "number",
                        "format": "double"
                    },
                    "west": {
                        "type": "number",
                        "format": "double"
                    },
                    "north": {
                        "type": "number",
                        "format": "double"
                    },
                    "east": {
                        "type": "number",
                        "format": "double"
                    }
                },
                "required": [
                    "east",
                    "north",
                    "south",
                    "west"
                ]
            },
            "DutyStatus": {
                "enum": [
                    "off",
                    "sleeper",
                    "driving",
                    "on_duty"
                ],
                "type": "string",
                "description": "* `off` - Off\n* `sleeper` - Sleeper\n* `driving` - Driving\n* `on_duty` - On Duty"
            },
            "ErrorBody": {
                "type": "object",
                "properties": {
                    "code": {
                        "$ref": "#/components/schemas/ErrorCode"
                    },
                    "message": {
                        "type": "string"
                    },
                    "field": {
                        "type": "string"
                    },
                    "details": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FieldError"
                        }
                    },
                    "retry_after_s": {
                        "type": "integer",
                        "maximum": 300,
                        "minimum": 1
                    },
                    "request_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "code",
                    "message",
                    "request_id"
                ]
            },
            "ErrorCode": {
                "enum": [
                    "VALIDATION_ERROR",
                    "LOCATION_NOT_FOUND",
                    "UNSUPPORTED_LOCATION",
                    "AMBIGUOUS_LOCATION",
                    "ROUTE_NOT_FOUND",
                    "TRIP_TOO_LONG",
                    "NOT_FOUND",
                    "METHOD_NOT_ALLOWED",
                    "RATE_LIMITED",
                    "UPSTREAM_QUOTA_EXCEEDED",
                    "UPSTREAM_UNAVAILABLE",
                    "INTERNAL"
                ],
                "type": "string",
                "description": "* `VALIDATION_ERROR` - VALIDATION_ERROR\n* `LOCATION_NOT_FOUND` - LOCATION_NOT_FOUND\n* `UNSUPPORTED_LOCATION` - UNSUPPORTED_LOCATION\n* `AMBIGUOUS_LOCATION` - AMBIGUOUS_LOCATION\n* `ROUTE_NOT_FOUND` - ROUTE_NOT_FOUND\n* `TRIP_TOO_LONG` - TRIP_TOO_LONG\n* `NOT_FOUND` - NOT_FOUND\n* `METHOD_NOT_ALLOWED` - METHOD_NOT_ALLOWED\n* `RATE_LIMITED` - RATE_LIMITED\n* `UPSTREAM_QUOTA_EXCEEDED` - UPSTREAM_QUOTA_EXCEEDED\n* `UPSTREAM_UNAVAILABLE` - UPSTREAM_UNAVAILABLE\n* `INTERNAL` - INTERNAL"
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "error": {
                        "$ref": "#/components/schemas/ErrorBody"
                    }
                },
                "required": [
                    "error"
                ]
            },
            "FieldError": {
                "type": "object",
                "properties": {
                    "field": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "field",
                    "message"
                ]
            },
            "HealthResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "$ref": "#/components/schemas/HealthResponseStatus"
                    },
                    "api_version": {
                        "$ref": "#/components/schemas/ApiVersion"
                    }
                },
                "required": [
                    "api_version",
                    "status"
                ]
            },
            "HealthResponseStatus": {
                "enum": [
                    "ok"
                ],
                "type": "string",
                "description": "* `ok` - ok"
            },
            "LabelSource": {
                "enum": [
                    "input",
                    "geocoded",
                    "nearby",
                    "coordinates"
                ],
                "type": "string",
                "description": "* `input` - Input\n* `geocoded` - Geocoded\n* `nearby` - Nearby\n* `coordinates` - Coordinates"
            },
            "LogDay": {
                "type": "object",
                "properties": {
                    "date": {
                        "type": "string",
                        "description": "YYYY-MM-DD in the frozen trip offset."
                    },
                    "sheet_index": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "from_label": {
                        "type": "string"
                    },
                    "to_label": {
                        "type": "string"
                    },
                    "miles_driven": {
                        "type": "number",
                        "format": "double"
                    },
                    "segments": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LogSegment"
                        }
                    },
                    "remarks": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LogRemark"
                        }
                    },
                    "totals": {
                        "$ref": "#/components/schemas/LogTotals"
                    },
                    "recap": {
                        "$ref": "#/components/schemas/LogRecap"
                    }
                },
                "required": [
                    "date",
                    "from_label",
                    "miles_driven",
                    "recap",
                    "remarks",
                    "segments",
                    "sheet_index",
                    "to_label",
                    "totals"
                ]
            },
            "LogHeader": {
                "type": "object",
                "properties": {
                    "driver_name": {
                        "type": "string"
                    },
                    "carrier_name": {
                        "type": "string"
                    },
                    "main_office_address": {
                        "type": "string"
                    },
                    "home_terminal_address": {
                        "type": "string"
                    },
                    "truck_number": {
                        "type": "string"
                    },
                    "trailer_number": {
                        "type": "string"
                    },
                    "shipping_doc": {
                        "type": "string"
                    },
                    "shipper_commodity": {
                        "type": "string"
                    }
                },
                "required": [
                    "carrier_name",
                    "driver_name",
                    "home_terminal_address",
                    "main_office_address",
                    "shipper_commodity",
                    "shipping_doc",
                    "trailer_number",
                    "truck_number"
                ]
            },
            "LogHeaderRequest": {
                "type": "object",
                "description": "Header text only; never affects HOS. Missing, null or blank all mean \"use the default\".",
                "properties": {
                    "driver_name": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 80
                    },
                    "carrier_name": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 100
                    },
                    "main_office_address": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 150
                    },
                    "home_terminal_address": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 150
                    },
                    "truck_number": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 40
                    },
                    "trailer_number": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 40
                    },
                    "shipping_doc": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 60
                    },
                    "shipper_commodity": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 100
                    }
                }
            },
            "LogRecap": {
                "type": "object",
                "properties": {
                    "on_duty_today": {
                        "type": "number",
                        "format": "double"
                    },
                    "a_last7": {
                        "type": "number",
                        "format": "double"
                    },
                    "b_available_tomorrow": {
                        "type": "number",
                        "format": "double"
                    },
                    "c_last8": {
                        "type": "number",
                        "format": "double"
                    },
                    "restart_note": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "required": [
                    "a_last7",
                    "b_available_tomorrow",
                    "c_last8",
                    "on_duty_today",
                    "restart_note"
                ]
            },
            "LogRemark": {
                "type": "object",
                "properties": {
                    "minute": {
                        "type": "integer",
                        "maximum": 1439,
                        "minimum": 0
                    },
                    "location_label": {
                        "type": "string"
                    },
                    "note": {
                        "type": "string"
                    }
                },
                "required": [
                    "location_label",
                    "minute",
                    "note"
                ]
            },
            "LogSegment": {
                "type": "object",
                "properties": {
                    "start_min": {
                        "type": "integer",
                        "maximum": 1440,
                        "minimum": 0
                    },
                    "end_min": {
                        "type": "integer",
                        "maximum": 1440,
                        "minimum": 0
                    },
                    "status": {
                        "$ref": "#/components/schemas/DutyStatus"
                    },
                    "location_label": {
                        "type": "string"
                    },
                    "note": {
                        "type": "string"
                    },
                    "stationary": {
                        "type": "boolean"
                    },
                    "stop_id": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "required": [
                    "end_min",
                    "location_label",
                    "note",
                    "start_min",
                    "stationary",
                    "status",
                    "stop_id"
                ]
            },
            "LogTotals": {
                "type": "object",
                "properties": {
                    "off": {
                        "type": "number",
                        "format": "double"
                    },
                    "sleeper": {
                        "type": "number",
                        "format": "double"
                    },
                    "driving": {
                        "type": "number",
                        "format": "double"
                    },
                    "on_duty": {
                        "type": "number",
                        "format": "double"
                    }
                },
                "required": [
                    "driving",
                    "off",
                    "on_duty",
                    "sleeper"
                ]
            },
            "PlaceSuggestion": {
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string"
                    },
                    "lat": {
                        "type": "number",
                        "format": "double"
                    },
                    "lng": {
                        "type": "number",
                        "format": "double"
                    }
                },
                "required": [
                    "label",
                    "lat",
                    "lng"
                ]
            },
            "PlanTripRequest": {
                "type": "object",
                "properties": {
                    "current_location": {
                        "$ref": "#/components/schemas/LocationInput"
                    },
                    "pickup_location": {
                        "$ref": "#/components/schemas/LocationInput"
                    },
                    "dropoff_location": {
                        "$ref": "#/components/schemas/LocationInput"
                    },
                    "current_cycle_used_hours": {
                        "type": "number",
                        "format": "double",
                        "maximum": 70,
                        "minimum": 0
                    },
                    "start_date": {
                        "type": "string",
                        "format": "date"
                    },
                    "start_time": {
                        "type": "string",
                        "pattern": "^([01][0-9]|2[0-3]):(00|15|30|45)$"
                    },
                    "log_header": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/LogHeaderRequest"
                            }
                        ],
                        "nullable": true
                    }
                },
                "required": [
                    "current_cycle_used_hours",
                    "current_location",
                    "dropoff_location",
                    "pickup_location"
                ]
            },
            "PlanTripResponse": {
                "type": "object",
                "properties": {
                    "trip": {
                        "$ref": "#/components/schemas/TripMeta"
                    },
                    "route": {
                        "$ref": "#/components/schemas/Route"
                    },
                    "stops": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Stop"
                        }
                    },
                    "timeline": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TimelineEvent"
                        }
                    },
                    "days": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LogDay"
                        }
                    },
                    "summary": {
                        "$ref": "#/components/schemas/TripSummary"
                    }
                },
                "required": [
                    "days",
                    "route",
                    "stops",
                    "summary",
                    "timeline",
                    "trip"
                ]
            },
            "ResolvedPlace": {
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string"
                    },
                    "lat": {
                        "type": "number",
                        "format": "double"
                    },
                    "lng": {
                        "type": "number",
                        "format": "double"
                    },
                    "source": {
                        "$ref": "#/components/schemas/LabelSource"
                    }
                },
                "required": [
                    "label",
                    "lat",
                    "lng",
                    "source"
                ]
            },
            "ResolvedPlaces": {
                "type": "object",
                "properties": {
                    "current": {
                        "$ref": "#/components/schemas/ResolvedPlace"
                    },
                    "pickup": {
                        "$ref": "#/components/schemas/ResolvedPlace"
                    },
                    "dropoff": {
                        "$ref": "#/components/schemas/ResolvedPlace"
                    }
                },
                "required": [
                    "current",
                    "dropoff",
                    "pickup"
                ]
            },
            "Route": {
                "type": "object",
                "properties": {
                    "profile": {
                        "$ref": "#/components/schemas/RouteProfile"
                    },
                    "distance_mi": {
                        "type": "number",
                        "format": "double"
                    },
                    "planned_driving_h": {
                        "type": "number",
                        "format": "double"
                    },
                    "bounds": {
                        "$ref": "#/components/schemas/Bounds"
                    },
                    "legs": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/RouteLeg"
                        }
                    }
                },
                "required": [
                    "bounds",
                    "distance_mi",
                    "legs",
                    "planned_driving_h",
                    "profile"
                ]
            },
            "RouteLeg": {
                "type": "object",
                "properties": {
                    "index": {
                        "type": "integer",
                        "maximum": 1,
                        "minimum": 0
                    },
                    "from_label": {
                        "type": "string"
                    },
                    "to_label": {
                        "type": "string"
                    },
                    "distance_mi": {
                        "type": "number",
                        "format": "double"
                    },
                    "duration_h": {
                        "type": "number",
                        "format": "double"
                    },
                    "planned_driving_h": {
                        "type": "number",
                        "format": "double"
                    },
                    "polyline": {
                        "type": "string",
                        "description": "Encoded polyline, precision 5."
                    },
                    "bounds": {
                        "$ref": "#/components/schemas/Bounds"
                    }
                },
                "required": [
                    "bounds",
                    "distance_mi",
                    "duration_h",
                    "from_label",
                    "index",
                    "planned_driving_h",
                    "polyline",
                    "to_label"
                ]
            },
            "RouteProfile": {
                "enum": [
                    "driving-hgv",
                    "driving-car"
                ],
                "type": "string",
                "description": "* `driving-hgv` - Hgv\n* `driving-car` - Car"
            },
            "Stop": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "kind": {
                        "$ref": "#/components/schemas/StopKind"
                    },
                    "lat": {
                        "type": "number",
                        "format": "double"
                    },
                    "lng": {
                        "type": "number",
                        "format": "double"
                    },
                    "label": {
                        "type": "string"
                    },
                    "label_source": {
                        "$ref": "#/components/schemas/LabelSource"
                    },
                    "arrive_at": {
                        "type": "string"
                    },
                    "depart_at": {
                        "type": "string"
                    },
                    "duration_h": {
                        "type": "number",
                        "format": "double"
                    },
                    "duty_status": {
                        "$ref": "#/components/schemas/DutyStatus"
                    },
                    "cumulative_mi": {
                        "type": "number",
                        "format": "double"
                    },
                    "leg_index": {
                        "type": "integer",
                        "maximum": 1,
